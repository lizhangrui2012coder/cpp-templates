{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build with GCC",
      "type": "shell",
      "command": "/opt/homebrew/bin/g++-15",
      "args": [
        "${file}",
        "-std=c++17",
        "-O2",
        "-Wall",
        "-o",
        "${fileDirname}/main"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}